--- /dev/null
+++ b/app/include/zmk/knob_bond_policy.h
@@ -0,0 +1,13 @@
+#pragma once
+/* Pure rules shared by connection admission and compile-time regression checks. */
+#define KNOB_BOND_SLOT(known, selected, open, pairing) \
+    ((known)>=0 ? (known) : ((open)&&(pairing) ? (selected) : -1))
+#define KNOB_BOND_VALID(slot, known, open, same, saved_generation, generation) \
+    ((slot)>=0 && (slot)<3 && ((known)<0 || (known)==(slot)) && \
+     ((open)||(same)) && (saved_generation)==(generation))
+_Static_assert(KNOB_BOND_SLOT(-1,1,1,1)==1,"New phone belongs to selected slot");
+_Static_assert(KNOB_BOND_SLOT(0,1,1,1)==0,"Existing PC must not occupy phone slot");
